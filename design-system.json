{
  "colors": {
    "primary": "#A96B4B",
    "accent": "#F3DCC4",
    "text_dark": "#21333D",
    "text_muted": "#6B7C86"
  },
  "typography": {
    "headings": {
      "font_family": "'Merriweather', serif",
      "google_font_import": "@import url('https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&display=swap');"
    },
    "body": {
      "font_family": "'Inter', sans-serif",
      "google_font_import": "@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap');"
    }
  },
  "buttons": {
    "border_radius": "10px",
    "box_shadow": "0 4px 8px rgba(0, 0, 0, 0.1)",
    "primary": {
      "background_color": "#A96B4B",
      "color": "#FFFFFF"
    },
    "secondary": {
      "border": "2px solid #A96B4B",
      "background_color": "transparent",
      "color": "#A96B4B"
    }
  },
  "imagery": {
    "style": "Natural light, soft grain, close family moments",
    "accessibility": "All images must have meaningful alt text."
  }
}
